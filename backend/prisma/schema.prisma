generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                        @id @default(autoincrement())
  firstName             String
  lastName              String
  email                 String                     @unique
  password              String
  age                   Int?
  category              String?
  otrId                 String                     @unique
  highestDegree         String?
  careerPreference      String?
  domicile              String?
  pincode               String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt
  credits               Int                        @default(0)
  referralCode          String                     @unique
  preferredLanguage     String                     @default("en")
  isDeleted             Boolean                    @default(false)
  role                  String                     @default("USER")
  applications          Application[]
  arthaRecentReports    ArthaRecentReport[]
  careerReadinessScores CareerReadinessTestScore[]
  mockTestAttempts      MockTestAttempt[]
  payments              Payment[]
  referralsMade         Referral[]                 @relation("ReferrerRelation")
  referralRewards       ReferralReward[]
  results               Result[]
  studyPlans            StudyPlan[]

  @@index([email])
  @@index([otrId])
  @@index([referralCode])
  @@index([createdAt])
  @@index([role])
  @@index([role, isDeleted])
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  deadline    DateTime
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([status])
  @@index([createdAt])
}

model Exam {
  id                Int           @id @default(autoincrement())
  name              String
  cutoff            Float?
  syllabus          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  eligibility       String?
  longDescription   String?
  noOfQuestions     Int?
  pattern           String?
  shortDescription  String?
  applicationStatus String        @default("Application Success")
  isDeleted         Boolean       @default(false)
  applications      Application[]
  mockTests         MockTest[]
  pyps              PYP[]
  studyPlans        StudyPlan[]
  tests             Test[]
  subjects          Subject[]     @relation("ExamToSubject")

  @@index([name])
  @@index([createdAt])
  @@index([isDeleted, createdAt])
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  isDeleted Boolean    @default(false)
  questions Question[]
  exams     Exam[]     @relation("ExamToSubject")

  @@index([name])
  @@index([isDeleted])
  subjectScores      SubjectScore[]
  mockAttemptScores  MockAttemptScore[]
}

model Question {
  id          Int      @id @default(autoincrement())
  text        String
  options     String[]
  answer      String
  explanation String?
  subjectId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tests       Test[]   @relation("QuestionToTest")

  @@index([subjectId])
  @@index([createdAt])
  @@index([subjectId, isDeleted])
}

model Test {
  id                    Int                        @id @default(autoincrement())
  name                  String
  examId                Int
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt
  isDeleted             Boolean                    @default(false)
  careerReadinessScores CareerReadinessTestScore[]
  results               Result[]
  exam                  Exam                       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions             Question[]                 @relation("QuestionToTest")

  @@index([examId])
  @@index([createdAt])
  @@index([isDeleted, createdAt])
}

model PYP {
  id        Int      @id @default(autoincrement())
  year      Int
  fileUrl   String
  examId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([year])
  @@index([isDeleted, examId])
}

model Subscription {
  id            Int       @id @default(autoincrement())
  title         String
  price         Float
  features      String[]
  isRecommended Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  isDeleted     Boolean   @default(false)
  payments      Payment[]

  @@index([createdAt])
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)

  @@index([username])
  @@index([email])
}

model Result {
  id               Int       @id @default(autoincrement())
  userId           Int
  testId           Int
  score            Float
  subjectBreakdown Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  tier             Int?
  startTime        DateTime?
  submitTime       DateTime?
  test             Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id])
  subjectScores    SubjectScore[]

  @@index([userId])
  @@index([testId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([testId, createdAt])
  @@index([isDeleted, createdAt])
}

model Application {
  id                Int      @id @default(autoincrement())
  userId            Int
  examId            Int
  status            String   @default("Applied")
  applicationStatus String   @default("Success")
  admitCardStatus   String   @default("Pending")
  examKeyStatus     String   @default("Pending")
  resultStatus      String   @default("Pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  isDeleted         Boolean  @default(false)
  exam              Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@index([createdAt])
  @@index([userId, examId])
  @@index([examId, status])
}

model MockTestCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isDeleted Boolean    @default(false)
  mockTests MockTest[]

  @@index([isDeleted])
}

model MockTest {
  id              Int               @id @default(autoincrement())
  title           String
  duration        Int
  sectionType     String
  isProctored     Boolean           @default(false)
  isAdaptive      Boolean           @default(false)
  categoryId      Int
  examId          Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  isDeleted       Boolean           @default(false)
  category        MockTestCategory  @relation(fields: [categoryId], references: [id])
  exam            Exam?             @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempts        MockTestAttempt[]
  referralRewards ReferralReward[]

  @@index([examId])
  @@index([categoryId])
  @@index([createdAt])
}

model MockTestAttempt {
  id               Int       @id @default(autoincrement())
  otrId            String
  mockTestId       Int
  score            Float
  totalMarks       Float
  correctAnswers   Int?
  subjectBreakdown Json?
  attemptedAt      DateTime  @default(now())
  startTime        DateTime?
  submitTime       DateTime?
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  mockTest         MockTest           @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [otrId], references: [otrId])
  subjectScores    MockAttemptScore[]

  @@index([otrId])
  @@index([mockTestId])
  @@index([attemptedAt])
  @@index([otrId, attemptedAt])
  @@index([mockTestId, attemptedAt])
  @@index([otrId, isDeleted, attemptedAt])
}

model CareerReadinessTestScore {
  id               Int      @id @default(autoincrement())
  otrId            String
  testId           Int
  totalScore       Float
  totalMarks       Float
  correctAnswers   Int
  wrongAnswers     Int
  negativeMarks    Float
  subjectBreakdown Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDeleted        Boolean  @default(false)
  user             User     @relation(fields: [otrId], references: [otrId])
  test             Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([otrId, testId], name: "otrId_testId")
  @@index([otrId])
  @@index([testId])
  @@index([createdAt])
  @@index([otrId, testId])
  @@index([isDeleted, createdAt])
}

model Payment {
  id                Int          @id @default(autoincrement())
  userId            Int
  subscriptionId    Int
  razorpayOrderId   String       @unique
  razorpayPaymentId String?      @unique
  razorpaySignature String?
  amount            Float
  currency          String       @default("INR")
  status            String       @default("created")
  idempotencyKey    String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  isDeleted         Boolean      @default(false)
  paymentMethod     String       @default("razorpay")
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  user              User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@index([status])
}

model Referral {
  id            Int      @id @default(autoincrement())
  referrerId    Int
  refereeOtrId  String
  status        String   @default("Joined")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  creditsEarned Int      @default(0)
  isDeleted     Boolean  @default(false)
  referrer      User     @relation("ReferrerRelation", fields: [referrerId], references: [id])

  @@unique([referrerId, refereeOtrId])
  @@index([referrerId])
  @@index([refereeOtrId])
  @@index([createdAt])
  @@index([status])
  @@index([referrerId, isDeleted])
}

model ReferralReward {
  id         Int      @id @default(autoincrement())
  userId     Int
  mockTestId Int
  isRedeemed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  isDeleted  Boolean  @default(false)
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([mockTestId])
  @@index([isDeleted])
}

model StudyPlan {
  id                  String         @id @default(uuid())
  userId              Int
  examId              Int?
  targetExam          String
  examDate            DateTime
  tier1Score          Int?
  tier2Score          Int?
  currentLevel        String
  weakAreas           String[]
  dailyStudyHours     Int
  mockFrequency       String
  revisionStrategy    String
  preferredStudyTimes String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  isDeleted           Boolean        @default(false)
  exam                Exam?          @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id])
  days                StudyPlanDay[]

  @@index([userId])
  @@index([examId])
  @@index([isDeleted, createdAt])
}

model StudyPlanDay {
  id         String          @id @default(uuid())
  day        String
  planId     String
  date       DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt
  isDeleted  Boolean         @default(false)
  activities StudyActivity[]
  plan       StudyPlan       @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([isDeleted])
}

model StudyActivity {
  id          String       @id @default(uuid())
  timeSlot    String
  description String
  focusArea   String?
  completed   Boolean      @default(false)
  missed      Boolean      @default(false)
  dayId       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  isDeleted   Boolean      @default(false)
  day         StudyPlanDay @relation(fields: [dayId], references: [id])

  @@index([dayId])
  @@index([isDeleted])
}

model ArthaProfile {
  id             String                @id @default(uuid())
  userId         String
  otrCompleted   Boolean               @default(false)
  logicalScore   Float
  quantScore     Float
  verbalScore    Float
  percentile     Float
  tier1Progress  Float
  tier2Progress  Float
  tier3Progress  Float
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  isDeleted      Boolean               @default(false)
  readinessIndex Float                 @default(0)
  assessments    ArthaAssessment[]
  feedback       IntelligenceFeedback?

  @@index([userId])
  @@index([isDeleted])
}

model ArthaAssessment {
  id             String                 @id @default(uuid())
  profileId      String
  tier           Int
  exam           String?
  logicalScore   Float?
  quantScore     Float?
  verbalScore    Float?
  subjectScores  Json?
  accuracy       Float?
  speed          Float?
  consistency    Float?
  percentile     Float?
  startTime      DateTime?
  submitTime     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt
  readinessIndex Float?
  score          Float?
  totalMarks     Int?
  status         String                 @default("COMPLETED")
  jobId          String?
  isDeleted      Boolean                @default(false)
  profile        ArthaProfile           @relation(fields: [profileId], references: [id])
  attempts       ArthaQuestionAttempt[]

  @@index([profileId])
  @@index([createdAt])
  @@index([status])
  @@index([profileId, isDeleted, createdAt])
}

model ArthaQuestionAttempt {
  id             String          @id @default(uuid())
  assessmentId   String
  questionId     Int
  selectedOption String
  isCorrect      Boolean
  timeTaken      Int
  attemptedAt    DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  isDeleted      Boolean         @default(false)
  assessment     ArthaAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([questionId])
  @@index([isDeleted])
}

model IntelligenceFeedback {
  id                 String       @id @default(uuid())
  profileId          String       @unique
  logicalFoundation  String?
  subjectDepth       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  isDeleted          Boolean      @default(false)
  readinessInsight   String?
  accuracyInsight    String?
  consistencyInsight String?
  preparationAdvice  String?
  speedInsight       String?
  subjectStrength    String?
  tier               Int          @default(1)
  weakAreas          String?
  examSuggestions    String?
  ArthaProfile       ArthaProfile @relation(fields: [profileId], references: [id])

  @@index([isDeleted])
}

model ArthaRecentReport {
  id               String   @id @default(uuid())
  otrId            String
  tier             Int
  score            Float
  totalMarks       Int
  accuracy         Float?
  speed            Float?
  consistency      Float?
  readinessIndex   Float?
  percentile       Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDeleted        Boolean  @default(false)
  subjectBreakdown Json?
  user             User     @relation(fields: [otrId], references: [otrId])

  @@unique([otrId, tier])
  @@index([otrId])
  @@index([createdAt])
  @@index([isDeleted, createdAt])
}

model IntelligenceProfile {
  id              String   @id @default(uuid())
  userId          String
  logicalScore    Int
  quantScore      Int
  verbalScore     Int
  interests       String[]
  learningPattern String
  confidenceIndex Int
  aspirations     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  isDeleted       Boolean  @default(false)
  roadmap         Roadmap?

  @@index([userId])
  @@index([isDeleted])
}

model Roadmap {
  id                  String              @id @default(uuid())
  profileId           String              @unique
  summary             String
  recommendations     String[]
  phase1              String
  phase2              String
  status              String                @default("COMPLETED")
  jobId               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  isDeleted           Boolean             @default(false)
  IntelligenceProfile IntelligenceProfile @relation(fields: [profileId], references: [id])

  @@index([isDeleted])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  userType  String   @default("USER") // Discriminator: "USER" or "ADMIN"
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  @@index([userId, userType])
  @@index([expiresAt])
  @@index([isDeleted])
}

model SubjectScore {
  id        Int     @id @default(autoincrement())
  resultId  Int
  subjectId Int
  correct   Int     @default(0)
  wrong     Int     @default(0)
  score     Float   @default(0)
  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@index([resultId])
  @@index([subjectId])
}

model MockAttemptScore {
  id              Int             @id @default(autoincrement())
  mockAttemptId   Int
  subjectId       Int
  correct         Int             @default(0)
  wrong           Int             @default(0)
  score           Float           @default(0)
  mockAttempt     MockTestAttempt @relation(fields: [mockAttemptId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id])

  @@index([mockAttemptId])
  @@index([subjectId])
}

