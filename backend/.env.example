# Database (PostgreSQL)
# ✅ Production: Use PgBouncer for high concurrency (500K users)
# Standard: postgres://user:password@localhost:5432/dbname
# With PgBouncer: postgres://user:password@localhost:6432/dbname?pgbouncer=true&connection_limit=50&statement_timeout=30000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otras_db?schema=public&statement_timeout=30000"

# Redis (Caching & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# JWT Secret
JWT_SECRET=supersecretchangeinprod
JWT_REFRESH_SECRET=refreshtokensecretchangeinprod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App Config
PORT=3000
NODE_ENV=development

# ML & AI Services
ML_SERVICE_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000/api/v1

# Razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Throttler (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
